# === stand/Dockerfile.gui ===
# Docker-образ для стенда GUI xswitcher с noVNC.

ARG NOVNC_VERSION=2.1.15

# --- Stage 1: builder (сборка daemon+GUI) --- #
FROM golang:1.23-alpine AS builder

ENV GOFLAGS=-buildvcs=false

RUN apk add --no-cache build-base git ca-certificates curl tar wget && \
    update-ca-certificates

WORKDIR /w
COPY go.mod go.sum ./
RUN go mod download

# Копируем только необходимые пакеты из репозитория
COPY src/ cmd/gui/ internal/ embeddedConfig/ exec/ scancodes/ sounds/ xswitcher.conf ./
RUN go build -o /w/bin/xswitcher-daemon ./src/ && \
    go build -o /w/bin/xswitcher-gui ./cmd/gui/

# noVNC + websockify
ARG NOVNC_VERSION=2.1.15
COPY --from=golang:1.23-alpine /usr/local/bin/go /usr/local/bin/go
RUN mkdir -p /opt/novnc && \
    curl -sL "https://github.com/novnc/noVNC/archive/${NOVNC_VERSION}.tar.gz" | tar xz -C /opt/novnc --strip-components=1 && \
    curl -sL "https://github.com/novnc/websockify/archive/master.tar.gz" | tar xz -C /opt/novnc

# --- Stage 2: app (тонкий образ) --- #
FROM alpine:3.20 AS app

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apk add --no-cache \
    bash python3 xorg-xinit xterm libXScrnSaver libxkbcommon-dev libxkbfile-dev && \
    update-ca-certificates

# noVNC + websockify
COPY --from=builder /opt/novnc /opt/novnc

# Демон и GUI-бинарники из builder'а
COPY --from=builder /w/bin/xswitcher-daemon /w/bin/xswitcher-daemon
COPY --from=builder /w/bin/xswitcher-gui /w/bin/xswitcher-gui

WORKDIR /w

# noVNC + websockify запускаются в фоне
EXPOSE 6081/tcp 5900/tcp 3001/udp
CMD ["bash", "-c", "/opt/novnc/websockify -D --web=/opt/novnc/noVNC --vnc=:5900 & sleep 1 && noVNC --host=0.0.0.0 --port=6081"]

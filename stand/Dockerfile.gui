# === stand/Dockerfile.gui ===
# The GUI stand: Xvfb + noVNC + the toolchain the stand builds and runs itself.
#
#   build context = the repository root, so the sources are mounted, never copied:
#       docker build -f stand/Dockerfile.gui -t xswitcher-gui-stand .
#   or, with the compose file:
#       cd stand && docker compose -f docker-compose.gui.yml up --build
#
# One stage on purpose. stand/gui-stand.sh compiles the daemon, the GUI and the three C
# helpers from the checkout it is pointed at, because the point of the stand is to look at a
# specific commit: an image with the binaries baked in would silently test an older build.
# The repository is bind-mounted at /w by docker-compose.gui.yml.
FROM golang:1.24-trixie

# The display server and the noVNC bridge, plus the observers the stand drives:
#   x11-utils      -> xprop, xwininfo
#   x11-xkb-utils  -> setxkbmap, xkbprint (the stand sets us,ru,de)
#   xdotool        -> window focus/geometry (getdisplaygeometry is the liveness gate)
#   imagemagick    -> import -window root (the G7 screenshot)
#   python3-evdev  -> stand/source_key.py, the uinput hand
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        x11-utils \
        x11-xkb-utils \
        xdotool \
        imagemagick \
        python3-evdev \
        kbd \
        xterm \
        ca-certificates \
# The C helpers and cmd/gui are built by the stand itself, so their headers ship with it.
# This set is the package list measured with `dpkg -l` inside the working VNC slot on
# 2026-10-15, not a guess: the X11/client libraries Fyne's go driver needs (cgo), plus
# libxtst-dev for the XTEST fake key events stand/echo.c and stand/bridge.c emit, plus
# xkb-data for the layouts themselves.
    && apt-get install -y --no-install-recommends \
        gcc \
        pkg-config \
        libxtst-dev \
        libx11-dev \
        libxext-dev \
        libxmu-dev \
        libxrender-dev \
        libxfixes-dev \
        libxi-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxxf86vm-dev \
        libxft-dev \
        libfontconfig-dev \
        libxkbcommon-dev \
        libgl1-mesa-dev \
        xkb-data \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /w

# The display the stand uses; keep it private, uinput is shared by the whole kernel of the
# Docker VM, so two stands on one display would read each other's keyboards.
ENV DISPLAY=:96 \
    GUISTAND_DISPLAY=96 \
    XSWITCHER_SOCK=/tmp/guistand.sock \
    GOFLAGS=-buildvcs=false

EXPOSE 6081

# Xvfb + the VNC bridge stay up for the life of the container; the checks themselves are run
# with:  docker exec xswitcher-gui-stand bash /w/stand/gui-stand.sh
# The display number is taken from GUISTAND_DISPLAY, not from DISPLAY: stand/gui-stand.sh derives
# its own DISPLAY from GUISTAND_DISPLAY, so a container started with -e GUISTAND_DISPLAY=97 has to
# get its Xvfb and x11vnc on :97 too, otherwise the stand looks for a server nobody started.
CMD ["bash", "-c", "X=:${GUISTAND_DISPLAY:-96}; export DISPLAY=$X; \
     Xvfb $X -noreset -screen 0 1280x1024x24 >/tmp/xvfb.log 2>&1 & \
     sleep 1 && x11vnc -display $X -forever -shared -nopw -rfbport 5900 -bg >/tmp/x11vnc.log 2>&1 && \
     websockify --web=/usr/share/novnc 6081 localhost:5900 >/tmp/websockify.log 2>&1 & \
     tail -f /dev/null"]
